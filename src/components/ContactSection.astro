---
---

<section class="py-16 sm:py-24 bg-[#1b1b18] text-white" id="contact">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Contact Info Left Column -->
      <div class="lg:col-span-5">
        <div class="inline-block bg-[#c81429] text-white text-[10px] uppercase font-bold tracking-widest px-2.5 py-1 rounded mb-3">
          Pre-Launch Expression of Interest
        </div>

        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-4 leading-tight">
          Register For Exclusive Pre-Launch Benefits
        </h2>

        <p class="text-sm sm:text-base text-gray-300 leading-relaxed mb-8">
          The project is currently in its pre-launch stage. Express your interest now to be among the first to receive layout details, indicative pricing, and priority allotment offers when launched.
        </p>

        <!-- 3 Highlights -->
        <div class="space-y-4">
          <div class="flex items-center gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-[#c81429] flex items-center justify-center flex-shrink-0 text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white text-sm">Priority Allotment</div>
              <div class="text-xs text-gray-400">First preference on choice of plots upon official launch.</div>
            </div>
          </div>

          <div class="flex items-center gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-[#c81429] flex items-center justify-center flex-shrink-0 text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white text-sm">Pre-Launch Price Advantage</div>
              <div class="text-xs text-gray-400">Special introductory price benefit for early registered buyers.</div>
            </div>
          </div>

          <div class="flex items-center gap-4 bg-white/5 p-4 rounded-lg border border-white/10">
            <div class="w-10 h-10 rounded-full bg-[#c81429] flex items-center justify-center flex-shrink-0 text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white text-sm">Direct Project Consultation</div>
              <div class="text-xs text-gray-400">Personalized consultation regarding township layout and connectivity.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form Card Right Column -->
      <div class="lg:col-span-7">
        <div class="bg-[#242420] p-6 sm:p-10 rounded-xl border border-white/10 shadow-2xl">
          <h3 class="font-serif font-bold text-xl sm:text-2xl text-white mb-2">
            Make An Enquiry
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 mb-6">
            Enter your details below to register your pre-launch enquiry.
          </p>

          <form class="crm-enquiry-form space-y-4">
            <input type="hidden" name="form_type" value="contact_section_enquiry" />
            <input type="hidden" name="lead_intent" value="Pre-Launch General Registration" />
            <input type="hidden" name="source_url" value="" class="source-url-field" />
            
            <!-- Honeypot -->
            <input type="text" name="website_honeypot" style="display:none;" tabindex="-1" autocomplete="off" />

            <div>
              <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5 font-semibold">Your Name *</label>
              <input 
                type="text" 
                name="name" 
                placeholder="Enter Full Name" 
                required 
                class="w-full bg-white/10 text-white placeholder-white/40 text-sm px-4 py-3.5 rounded border border-white/20 focus:outline-none focus:border-[#c81429] transition-colors"
              />
            </div>

            <div>
              <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5 font-semibold">Mobile Number *</label>
              <input 
                type="tel" 
                name="phone" 
                placeholder="Enter 10-Digit Mobile Number" 
                required 
                pattern="[0-9]{10}"
                title="Please enter a valid 10-digit mobile number"
                class="w-full bg-white/10 text-white placeholder-white/40 text-sm px-4 py-3.5 rounded border border-white/20 focus:outline-none focus:border-[#c81429] transition-colors"
              />
            </div>

            <!-- Non-clickable Disclaimer -->
            <p class="text-xs text-gray-400 leading-relaxed pt-1">
              * By submitting this form, you authorize our representative to contact you with project details and pre-launch updates.
            </p>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full bg-[#c81429] hover:bg-[#a50e20] text-white font-bold text-sm uppercase tracking-widest py-4 rounded shadow-lg transition-all active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Submit Enquiry</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <!-- Status message container -->
            <div class="form-status text-center text-sm font-medium py-2 rounded" role="status"></div>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>
