---
import { siteConfig } from '../config/site';

const slides = [
  { src: '/images/hero-slide-1.jpg', alt: 'Hero Homes Lucknow township plots' },
  { src: '/images/hero-slide-2.jpg', alt: 'Hero Homes Lucknow landscaped avenue' },
  { src: '/images/hero-slide-3.jpg', alt: 'Hero Homes Lucknow green park' },
  { src: '/images/hero-slide-4.jpg', alt: 'Hero Homes Lucknow avenue' },
];
---

<section class="relative min-h-[560px] sm:min-h-[640px] lg:min-h-[700px] flex items-center justify-center overflow-hidden bg-black text-white" id="home">
  
  <!-- Image Slider Background -->
  <div class="absolute inset-0 z-0">
    {slides.map((slide, index) => (
      <div 
        class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
        data-slide-index={index}
      >
        <img 
          src={slide.src} 
          alt={slide.alt}
          class="w-full h-full object-cover scale-105 transition-transform duration-10000 ease-linear animate-subtle-zoom"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
        />
      </div>
    ))}
    <!-- Dark Vignette Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/60 z-10 pointer-events-none"></div>
  </div>

  <!-- Hero Content Box -->
  <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 text-center py-16 sm:py-24">
    
    <!-- Location Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#ff4d61] text-xs sm:text-sm font-semibold uppercase tracking-widest mb-6">
      <svg class="w-4 h-4 text-[#c81429]" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
      </svg>
      <span>{siteConfig.location}</span>
    </div>

    <!-- H1 Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight leading-tight sm:leading-none mb-4">
      Hero Homes Lucknow
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-2xl text-[#f3f3f3] font-medium tracking-wide mb-3">
      Premium Residential Plots & Villas
    </p>

    <!-- Tagline -->
    <p class="text-sm sm:text-base text-gray-300 max-w-2xl mx-auto italic font-light mb-8 sm:mb-10">
      "A Gated Township Where Dreams Take Shape"
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto mb-10">
      <button 
        type="button"
        data-open-modal
        data-intent="Enquire Now - Hero"
        class="w-full sm:w-auto bg-[#c81429] hover:bg-[#a50e20] text-white font-bold text-xs sm:text-sm uppercase tracking-widest px-8 py-4 rounded shadow-lg transition-all duration-200 active:scale-95"
      >
        Enquire Now
      </button>

      <button 
        type="button"
        data-open-modal
        data-intent="Pre-Launch Brochure - Hero"
        class="w-full sm:w-auto bg-transparent hover:bg-white/10 text-white border border-white/50 hover:border-white font-bold text-xs sm:text-sm uppercase tracking-widest px-8 py-4 rounded transition-all duration-200 active:scale-95 flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Pre-Launch Brochure
      </button>
    </div>

    <!-- Pre-launch Status Pill (No RERA number) -->
    <div class="inline-block bg-black/60 backdrop-blur-md px-5 py-2.5 rounded-full border border-white/15 text-xs text-white/80">
      <span class="text-[#ff4d61] font-semibold">● Pre-Launch Phase:</span>
      <span class="ml-1.5">Expression of Interest (EOI) Now Open</span>
    </div>

  </div>

  <!-- Slider Controls -->
  <button 
    id="heroPrevBtn" 
    class="absolute left-4 top-1/2 -translate-y-1/2 z-20 hidden sm:flex items-center justify-center w-11 h-11 rounded-full bg-black/40 hover:bg-black/70 text-white border border-white/20 transition-colors"
    aria-label="Previous Slide"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button 
    id="heroNextBtn" 
    class="absolute right-4 top-1/2 -translate-y-1/2 z-20 hidden sm:flex items-center justify-center w-11 h-11 rounded-full bg-black/40 hover:bg-black/70 text-white border border-white/20 transition-colors"
    aria-label="Next Slide"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Slider Dot Indicators -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center space-x-2">
    {slides.map((_, i) => (
      <button 
        class={`hero-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-[#c81429] w-6' : 'bg-white/40 hover:bg-white/80'}`}
        data-slide-target={i}
        aria-label={`Go to slide ${i + 1}`}
      />
    ))}
  </div>

</section>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLElement>('.hero-dot');
  const totalSlides = slides.length;

  function showSlide(index: number) {
    slides.forEach((s, i) => {
      if (i === index) {
        s.classList.remove('opacity-0');
        s.classList.add('opacity-100');
      } else {
        s.classList.remove('opacity-100');
        s.classList.add('opacity-0');
      }
    });

    dots.forEach((d, i) => {
      if (i === index) {
        d.classList.add('bg-[#c81429]', 'w-6');
        d.classList.remove('bg-white/40', 'w-2.5');
      } else {
        d.classList.remove('bg-[#c81429]', 'w-6');
        d.classList.add('bg-white/40', 'w-2.5');
      }
    });
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % totalSlides);
  }

  function prevSlide() {
    showSlide((currentSlide - 1 + totalSlides) % totalSlides);
  }

  document.getElementById('heroNextBtn')?.addEventListener('click', nextSlide);
  document.getElementById('heroPrevBtn')?.addEventListener('click', prevSlide);

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => showSlide(index));
  });

  if (totalSlides > 1) {
    setInterval(nextSlide, 5000);
  }
</script>
