---
---

<section class="py-16 sm:py-24 bg-white" id="walkthrough">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Head -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="eyebrow-badge">Project Walkthrough</div>
      <h2 class="text-2xl sm:text-4xl font-serif font-bold text-[#141414] mb-4">
        Hero Homes Lucknow Virtual Walkthrough
      </h2>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
        Watch the project walkthrough to explore the premium residential township, wide internal roads, landscaped green spaces, modern infrastructure, lifestyle amenities, and excellent connectivity — before your site visit.
      </p>
    </div>

    <!-- Video / Walkthrough Preview Container -->
    <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-gray-200 group">
      <img 
        src="/images/walkthrough-thumb.jpg" 
        alt="Hero Homes Lucknow virtual walkthrough preview"
        class="w-full h-[320px] sm:h-[460px] object-cover group-hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
      <!-- Vignette and Dark Tint -->
      <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors flex flex-col items-center justify-center p-6 text-center">
        
        <!-- Big Play Button -->
        <button 
          type="button"
          data-open-modal
          data-intent="Watch Walkthrough Video"
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#c81429] hover:bg-[#a50e20] text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform mb-5"
          aria-label="Play virtual walkthrough"
        >
          <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.841z" />
          </svg>
        </button>

        <span class="text-xs uppercase tracking-widest text-white/80 font-semibold mb-2">
          3D Architectural Aerial Video
        </span>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4">
          Experience The Township in High Definition
        </h3>

        <button 
          type="button"
          data-open-modal
          data-intent="Request Project Video"
          class="bg-white/20 hover:bg-white text-white hover:text-[#c81429] text-xs uppercase font-bold tracking-wider px-6 py-2.5 rounded backdrop-blur-md transition-colors"
        >
          Watch Project Walkthrough
        </button>

      </div>
    </div>

  </div>
</section>
