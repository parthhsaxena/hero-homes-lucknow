---
const galleryImages = [
  { src: '/images/gallery-plots.jpg', alt: 'Township plots', title: 'Township Plots Layout', span: 'col-span-1 sm:col-span-2 lg:col-span-2 row-span-2' },
  { src: '/images/gallery-avenue.jpg', alt: 'Landscaped avenue', title: 'Landscaped Avenue', span: 'col-span-1' },
  { src: '/images/gallery-boulevard.jpg', alt: 'Green boulevard', title: 'Green Boulevard', span: 'col-span-1' },
  { src: '/images/gallery-road.jpg', alt: 'Township road', title: 'Township Wide Internal Road', span: 'col-span-1' },
  { src: '/images/gallery-aerial.jpg', alt: 'Aerial park view', title: 'Aerial Park & Green View', span: 'col-span-1' },
];
---

<section class="py-16 sm:py-24 bg-[#141414] text-white" id="gallery">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Head -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 text-xs uppercase font-bold tracking-[0.25em] text-[#ff4d61] mb-3">
        Gallery
      </div>
      <h2 class="text-2xl sm:text-4xl font-serif font-bold text-white mb-4">
        A Glimpse of the Township
      </h2>
      <p class="text-sm sm:text-base text-gray-300">
        Experience the thoughtful planning, expansive open spaces, and modern architecture of Hero Homes Lucknow.
      </p>
    </div>

    <!-- Gallery Masonry / Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {galleryImages.map((img) => (
        <div class={`relative group overflow-hidden rounded-lg bg-black/40 border border-white/10 ${img.span}`}>
          <img 
            src={img.src} 
            alt={img.alt}
            class="w-full h-full min-h-[220px] object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-5">
            <span class="text-xs uppercase tracking-wider text-[#ff4d61] font-bold">Hero Homes Lucknow</span>
            <h3 class="text-base font-serif font-bold text-white">{img.title}</h3>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
