---
const locationAdvantages = [
  { place: "Kanpur–Lucknow Road", time: "2 Min" },
  { place: "Lucknow Outer Ring Road (Kisan Path)", time: "5 Min" },
  { place: "Sports Authority of India (SAI)", time: "7 Min" },
  { place: "UP Sainik School", time: "8 Min" },
  { place: "Shaheed Path Junction", time: "10 Min" },
  { place: "Amausi Metro Station", time: "15 Min" },
  { place: "Chaudhary Charan Singh International Airport", time: "15 Min" },
  { place: "Charbagh Railway Station", time: "20 Min" },
  { place: "Medanta & Multi-Speciality Hospitals", time: "Nearby" },
  { place: "Leading Schools & Universities", time: "Nearby" },
];
---

<section class="py-16 sm:py-24 bg-[#F5F5F4]" id="location">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Head -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="eyebrow-badge">Location Advantage</div>
      <h2 class="text-2xl sm:text-4xl font-serif font-bold text-[#141414] mb-4">
        Prime Location Advantages
      </h2>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
        Located right on the high-growth Kanpur–Lucknow expressway corridor, offering unmatched accessibility and rapid capital appreciation.
      </p>
    </div>

    <!-- 2 Column: Distance List and Google Map -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Distance List -->
      <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-xl border border-[#e5e5e0] shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="font-serif font-bold text-xl text-[#141414] mb-6 border-b border-gray-100 pb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#c81429]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            Why This Location
          </h3>

          <ul class="divide-y divide-gray-100 text-sm">
            {locationAdvantages.map((item) => (
              <li class="py-3 flex items-center justify-between">
                <span class="text-gray-700 font-medium">{item.place}</span>
                <span class="font-bold text-[#c81429] bg-[#c81429]/10 px-2.5 py-1 rounded text-xs">
                  {item.time}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-gray-100">
          <button 
            type="button"
            data-open-modal
            data-intent="Get Route & Directions - Location"
            class="w-full bg-[#141414] hover:bg-[#c81429] text-white text-xs uppercase font-bold tracking-wider py-3.5 rounded transition-colors text-center"
          >
            Get Location Map & Directions
          </button>
        </div>
      </div>

      <!-- Responsive Google Maps Embed -->
      <div class="lg:col-span-7 bg-white rounded-xl overflow-hidden border border-[#e5e5e0] shadow-sm min-h-[380px] flex flex-col">
        <div class="p-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between text-xs text-gray-600">
          <span class="font-bold text-gray-800">Map: Kanpur–Lucknow Road, Lucknow</span>
          <span class="text-emerald-700 font-medium">● Prime Growth Zone</span>
        </div>
        <div class="flex-1 w-full relative">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d113974.77926715694!2d80.84152758925781!3d26.77741639999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399bf8b7f87968db%3A0xb5e7300c14c5771f!2sKanpur%20-%20Lucknow%20Rd%2C%20Lucknow%2C%20Uttar%20Pradesh!5e0!3m2!1sen!2sin!4v1709460000000!5m2!1sen!2sin" 
            class="w-full h-full min-h-[380px] border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Hero Homes Lucknow Location Map"
          ></iframe>
        </div>
      </div>

    </div>

  </div>
</section>
