---
---

<section class="py-14 sm:py-16 bg-gradient-to-r from-[#c81429] to-[#9b0d1e] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 text-center lg:text-left">
      
      <div class="max-w-3xl">
        <div class="inline-block bg-white/20 text-white text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-sm mb-3">
          Hero Homes Lucknow
        </div>
        <h3 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-white mb-3 leading-tight">
          Build Your Dream Home at Hero Homes Lucknow
        </h3>
        <p class="text-sm sm:text-base text-white/90 leading-relaxed max-w-2xl">
          Discover premium residential plots in a well-planned gated township with excellent connectivity, modern infrastructure, green surroundings, and attractive investment opportunities.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto flex-shrink-0">
        <button 
          type="button"
          data-open-modal
          data-intent="Get Best Price - CTA Strip"
          class="bg-white hover:bg-gray-100 text-[#c81429] font-bold text-xs sm:text-sm uppercase tracking-wider px-8 py-4 rounded shadow-md transition-all active:scale-95"
        >
          Get Best Price
        </button>

        <button 
          type="button"
          data-open-modal
          data-intent="Enquire Now - CTA Strip"
          class="bg-transparent hover:bg-black/20 text-white border-2 border-white font-bold text-xs sm:text-sm uppercase tracking-wider px-8 py-4 rounded transition-all active:scale-95"
        >
          Enquire Now
        </button>
      </div>

    </div>
  </div>
</section>
